<% content_for :page_title do %>
  Webhook VietQR #<%= @event.id %>
<% end %>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row">
      <dt class="col-sm-3">Nhà cung cấp</dt><dd class="col-sm-9"><%= @event.provider %></dd>
      <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9"><%= @event.status %></dd>
      <dt class="col-sm-3">Transaction ID</dt><dd class="col-sm-9"><%= @event.provider_transaction_id %></dd>
      <dt class="col-sm-3">Số tiền</dt><dd class="col-sm-9"><%= number_with_delimiter(@event.amount_cents) if @event.amount_cents %></dd>
      <dt class="col-sm-3">Đơn đọc được</dt><dd class="col-sm-9"><%= @event.parsed_order_code %></dd>
      <dt class="col-sm-3">Đơn đã khớp</dt><dd class="col-sm-9"><%= @event.matched_order_number %></dd>
      <dt class="col-sm-3">Tài khoản nhận</dt><dd class="col-sm-9"><%= @event.receiving_account&.account_number || @event.account_number %></dd>
      <dt class="col-sm-3">Allocation</dt><dd class="col-sm-9"><%= @event.payment_allocation_id %></dd>
      <dt class="col-sm-3">Link thanh toán</dt><dd class="col-sm-9"><%= @event.payment_link_id %></dd>
      <dt class="col-sm-3">Lỗi</dt><dd class="col-sm-9"><%= @event.error_message %></dd>
    </dl>
  </div>
</div>

<% if @event.status.in?(%w[unmatched error]) %>
  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: manual_match_admin_webhook_event_path(@event), method: :post, local: true, class: 'mb-3' do %>
        <div class="input-group">
          <%= text_field_tag :order_number, @event.parsed_order_code, class: 'form-control', placeholder: 'Mã đơn hàng' %>
          <%= submit_tag 'Khớp thủ công', class: 'btn btn-primary' %>
        </div>
      <% end %>

      <%= button_to 'Xử lý lại', retry_processing_admin_webhook_event_path(@event), method: :post, class: 'btn btn-outline-secondary' %>
    </div>
  </div>
<% end %>

<h5>Payload gốc</h5>
<pre class="bg-light p-3"><%= JSON.pretty_generate(@event.raw_payload || {}) %></pre>

<h5>Header gốc</h5>
<pre class="bg-light p-3"><%= JSON.pretty_generate(@event.raw_headers || {}) %></pre>

<%= link_to 'Quay lại', admin_webhook_events_path, class: 'btn btn-link' %>
