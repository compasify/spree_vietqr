<% content_for :page_title do %>
  Webhook VietQR
<% end %>

<div class="space-y-6">
  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="bg-white border rounded-lg p-4">
      <p class="text-xs font-medium text-gray-500 uppercase">Tổng hôm nay</p>
      <p class="text-2xl font-bold text-gray-900"><%= @stats[:total_today] %></p>
    </div>
    <div class="bg-white border rounded-lg p-4">
      <p class="text-xs font-medium text-gray-500 uppercase">Đã xác nhận hôm nay</p>
      <p class="text-2xl font-bold text-green-600"><%= @stats[:confirmed_today] %></p>
    </div>
    <div class="bg-white border rounded-lg p-4">
      <p class="text-xs font-medium text-gray-500 uppercase">Chưa khớp</p>
      <p class="text-2xl font-bold text-amber-600"><%= @stats[:unmatched] %></p>
    </div>
  </div>

  <%= render_table @collection, :vietqr_webhook_events %>
</div>
