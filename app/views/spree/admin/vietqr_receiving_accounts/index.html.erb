<% content_for :page_title do %>
  Tài khoản VietQR
<% end %>

<% accounts = @accounts.to_a %>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center mb-3">
  <div>
    <h5 class="mb-1"><%= @payment_method.name %></h5>
    <p class="text-muted mb-0">
      Cách chọn <code><%= @payment_method.account_routing_strategy %></code>. Provider được cấu hình riêng trên từng tài khoản.
    </p>
  </div>
  <div class="mt-3 mt-lg-0">
    <%= link_to 'Quay lại', edit_admin_payment_method_path(@payment_method), class: 'btn btn-outline-secondary mr-2' %>
    <%= link_to 'Thêm', new_admin_payment_method_vietqr_receiving_account_path(@payment_method), class: 'btn btn-primary' %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header bg-light">
    <strong>Danh sách tài khoản</strong>
  </div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Trạng thái</th>
          <th>Provider</th>
          <th>Keyword</th>
          <th>Ưu tiên</th>
          <th>Ngân hàng</th>
          <th>Số tài khoản</th>
          <th>Chủ tài khoản</th>
          <th>Hạn mức</th>
          <th>Đã giữ</th>
          <th>Đã nhận</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% accounts.each do |account| %>
          <tr>
            <td>
              <%= form_with scope: :receiving_account,
                            url: admin_payment_method_vietqr_receiving_account_path(@payment_method, account),
                            method: :patch,
                            local: true,
                            class: 'mb-0' do |active_form| %>
                <div class="d-inline-flex align-items-center">
                  <%= active_form.check_box :active,
                                            checked: account.active?,
                                            class: 'sr-only',
                                            id: "receiving_account_active_#{account.id}",
                                            aria: { label: 'Bật/tắt tài khoản' },
                                            onchange: 'this.form.requestSubmit()' %>
                  <label for="receiving_account_active_<%= account.id %>"
                         class="mb-0"
                         style="position: relative; width: 36px; height: 20px; border-radius: 999px; cursor: pointer; background: <%= account.active? ? '#28a745' : '#adb5bd' %>;">
                    <span style="position: absolute; top: 2px; left: <%= account.active? ? '18px' : '2px' %>; width: 16px; height: 16px; border-radius: 50%; background: #fff;"></span>
                  </label>
                  <span class="ml-2"><%= account.active? ? 'Đang bật' : 'Đã tắt' %></span>
                </div>
              <% end %>
            </td>
            <td><code><%= account.provider %></code></td>
            <td><code><%= account.keyword_init.presence || '-' %></code></td>
            <td>
              <%= form_with scope: :receiving_account,
                            url: admin_payment_method_vietqr_receiving_account_path(@payment_method, account),
                            method: :patch,
                            local: true,
                            class: 'd-inline-flex align-items-center' do |priority_form| %>
                <%= priority_form.number_field :priority, value: account.priority, class: 'form-control form-control-sm mr-2', style: 'width: 80px;' %>
                <%= priority_form.submit 'Lưu', class: 'btn btn-sm btn-outline-secondary' %>
              <% end %>
            </td>
            <td><%= account.bank_name.presence || account.bank_bin %></td>
            <td><code><%= account.account_number %></code></td>
            <td><%= account.account_name %></td>
            <td><%= number_with_delimiter(account.monthly_quota_amount) if account.monthly_quota_amount.present? %></td>
            <td><%= number_with_delimiter(account.period_allocated_amount) %></td>
            <td><%= number_with_delimiter(account.period_confirmed_amount) %></td>
            <td class="text-right">
              <%= link_to 'Sửa', edit_admin_payment_method_vietqr_receiving_account_path(@payment_method, account), class: 'btn btn-sm btn-outline-secondary' %>
              <% unless account.payment_allocations.exists? %>
                <%= button_to 'Xóa',
                              admin_payment_method_vietqr_receiving_account_path(@payment_method, account),
                              method: :delete,
                              class: 'btn btn-sm btn-outline-danger',
                              form: { class: 'd-inline' },
                              data: { turbo_confirm: 'Tiếp tục?' } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="card">
  <div class="card-header bg-light">
    <strong>Giao dịch gần đây</strong>
  </div>
  <div class="table-responsive">
    <table class="table mb-0">
      <thead>
        <tr>
          <th>Đơn hàng</th>
          <th>Thanh toán</th>
          <th>Tài khoản</th>
          <th>Số tiền</th>
          <th>Trạng thái</th>
          <th>Ngày tạo</th>
        </tr>
      </thead>
      <tbody>
        <% if @allocations.any? %>
          <% @allocations.each do |allocation| %>
            <tr>
              <td><%= allocation.order_number %></td>
              <td><%= allocation.payment_id %></td>
              <td><code><%= allocation.account_number %></code></td>
              <td><%= number_with_delimiter(allocation.expected_amount) %></td>
              <td><%= allocation.status %></td>
              <td><%= l(allocation.created_at, format: :short) if allocation.created_at %></td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted py-4">Không có dữ liệu</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
